 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Object Permanence in AI-Generated Videos\n",
    "## Interactive 30% Prototype Evaluation Notebook\n",
    "\n",
    "This notebook demonstrates the **Object Permanence Evaluation Framework** built using **YOLOv8** detection, **ByteTrack** tracking, and spatial/temporal track lifecycle analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "import pandas as pd
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Ensure project root is in python path\n",
    "project_root = os.path.dirname(os.getcwd())\n",
    "if project_root not in sys.path:\n",
    "    sys.path.append(project_root)\n",
    "\n",
    "from src.video_processor import VideoProcessor\n",
    "from src.detector_tracker import ObjectDetectorTracker\n",
    "from src.permanence_analyzer import ObjectPermanenceAnalyzer\n",
    "from src.metrics import MetricsCalculator\n",
    "from src.visualization import PermanenceVisualizer"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 1: Generate / Select Input Video"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from tools.create_demo_video import create_synthetic_occlusion_video\n",
    "\n",
    "video_path = os.path.join(project_root, \"data\", \"input\", \"demo_occlusion.mp4\")\n",
    "if not os.path.exists(video_path):\n",
    "    create_synthetic_occlusion_video(video_path)\n",
    "print(f\"Target Video: {video_path}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 2: Run Object Detection & ByteTrack Tracking"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "vp = VideoProcessor(video_path)\n",
    "v_info = vp.get_info()\n",
    "print(\"Video Metadata:\", v_info)\n",
    "\n",
    "tracker = ObjectDetectorTracker(weights=\"yolov8n.pt\", tracker_config=\"bytetrack.yaml\")\n",
    "\n",
    "for frame_idx, frame in vp.read_frames():\n",
    "    tracker.process_frame(frame, frame_idx)\n",
    "\n",
    "vp.close()\n",
    "detections_df = tracker.get_dataframe()\n",
    "print(f\"Total Detection Records: {len(detections_df)}\")\n",
    "detections_df.head(10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 3: Analyze Disappearance & Reappearance Events"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "analyzer = ObjectPermanenceAnalyzer(\n",
    "    min_missing_frames=3,\n",
    "    max_reappearance_gap=90,\n",
    "    frame_width=v_info['width'],\n",
    "    frame_height=v_info['height']\n",
    ")\n",
    "\n",
    "events_df, events_list = analyzer.analyze_permanence(detections_df)\n",
    "print(f\"Total Events Identified: {len(events_df)}\")\n",
    "events_df"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 4: Calculate Permanence Research Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "calc = MetricsCalculator(v_info)\n",
    "summary = calc.compute_metrics(detections_df, events_df)\n",
    "metrics = summary['metrics']\n",
    "print(f\"Detection Consistency:  {metrics['detection_consistency_pct']}%\")\n",
    "print(f\"Identity Consistency:   {metrics['identity_consistency_pct']}%\")\n",
    "print(f\"Object Permanence Score: {metrics['object_permanence_score_pct']}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Step 5: Visualize Trajectories & Evaluation Plots"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plots_dir = os.path.join(project_root, \"outputs\", \"plots\")\n",
    "viz = PermanenceVisualizer(plots_dir)\n",
    "p1 = viz.plot_track_trajectories(detections_df, events_df)\n",
    "p2 = viz.plot_metrics_summary(summary)\n",
    "p3 = viz.plot_event_breakdown(summary)\n",
    "\n",
    "# Display plot\n",
    "img = plt.imread(p1)\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.imshow(img)\n",
    "plt.axis('off')
    "plt.show()"
   ]
  }
 ],
